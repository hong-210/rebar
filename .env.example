# Environment Variables

# 데이터 저장 방식
#   (비워 두거나 local) 브라우저에만 저장하고 로그인 없이 관리자로 바로 입장 - 테스트용
#   supabase            Supabase DB에 저장하고 회원가입/로그인 사용 (아래 두 값 필요)
VITE_DATA_MODE=local

# Supabase (대시보드 > Project Settings > API) - VITE_DATA_MODE=supabase 일 때만 사용
# URL은 도메인까지만 입력한다 (끝에 /rest/v1/ 를 붙이지 않는다)
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=
